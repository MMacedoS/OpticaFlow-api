# Imagem de producao da API: compila no primeiro estagio e leva para o
# segundo apenas o build e as dependencias de producao.

FROM node:22-alpine AS build

WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .
RUN npx prisma generate && npm run build


FROM node:22-alpine

ENV NODE_ENV=production
WORKDIR /app

COPY package*.json ./
RUN npm ci --omit=dev && npm cache clean --force

COPY prisma ./prisma
COPY prisma.config.ts ./
RUN npx prisma generate

COPY --from=build /app/dist ./dist

USER node
EXPOSE 3000

# Aplica as migrations pendentes antes de subir a API. Com RUN_SEED=true
# tambem roda o seed (acessos, permissoes e superadmin); use so no primeiro
# deploy, porque o seed redefine a senha do superadmin.
CMD ["sh", "-c", "npx prisma migrate deploy && if [ \"$RUN_SEED\" = true ]; then node dist/prisma/seed.js; fi && node dist/src/main"]
