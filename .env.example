# Conexao com o PostgreSQL (no docker compose o host e "postgres")
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/opticaflow
# Conexao direta usada pelas migrations. So e necessaria quando a DATABASE_URL
# passa por um pooler (no Neon, a URL sem "-pooler" no host).
# DIRECT_URL=

# Segredos dos tokens JWT: use valores longos e aleatorios em producao
JWT_SECRET=troque-este-segredo
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=troque-este-outro-segredo
JWT_REFRESH_EXPIRATION=7d

PORT=3000

# Origens do frontend liberadas no CORS, separadas por virgula
FRONTEND_URL=http://localhost:5173

# Documentacao em /docs (defina false para desligar)
SWAGGER_ENABLED=true

# Superadmin criado pelo seed
SEED_SUPER_ADMIN_EMAIL=superadmin@opticaflow.local
SEED_SUPER_ADMIN_USERNAME=superadmin
SEED_SUPER_ADMIN_PASSWORD=SuperAdmin@123

# Somente na imagem de producao: roda o seed ao iniciar (use no primeiro deploy)
# RUN_SEED=true
